VITE_SUPABASE_URL=https://your-supabase-url.example.com
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ---------------------------------------------------------------------------
# Task-intelligence provider (frontend / Vite)
# ---------------------------------------------------------------------------
# Optional. Omit it (the default) to keep the deterministic on-device parser.
# Set it to "openai" to additionally offer the "Generate with AI" button.
#
# This selects a FEATURE. It carries no credential and is safe to expose.
#
# VITE_AI_TASK_PROVIDER=openai
#
# ---------------------------------------------------------------------------
# NEVER add the OpenAI API key here.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY, OPENAI_MODEL and the provider default are SUPABASE EDGE
# FUNCTION environment variables, not Vite variables. A VITE_ variable is
# inlined into the browser bundle at build time, so anything placed there is
# public. See supabase/ops/RUNBOOK.md for the server-side setup.